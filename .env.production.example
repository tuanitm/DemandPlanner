# ============================================
# DemandPlanner Production Environment
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# --- MySQL ---
MYSQL_HOST=192.168.30.91
MYSQL_PORT=3306
MYSQL_DB=demandplanner
MYSQL_USER=planner
# IMPORTANT: If your password contains special characters (like '@'), they MUST be URL-encoded!
# For example, 'planner@2026' must be written as 'planner%402026'
MYSQL_PASSWORD=planner%402026

# --- Application ---
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
ENVIRONMENT=production

# --- Frontend ---
# Set this to your server's domain or IP address
# Example: http://192.168.1.100/api  or  https://demandplanner.company.com/api
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP/api
