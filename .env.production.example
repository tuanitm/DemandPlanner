# ============================================
# DemandPlanner — Linux Production Environment
# ============================================
# Copy this file to .env and fill in the values:
#   cp .env.production.example .env && nano .env
#
# NEVER commit .env to version control!

# ──────────────────────────────────────────
# MySQL (External — not managed by Docker)
# ──────────────────────────────────────────
MYSQL_HOST=192.168.30.91
MYSQL_PORT=3386
MYSQL_DB=demandplanner
MYSQL_USER=planner
# IMPORTANT: Special characters in the password MUST be URL-encoded!
# '@' → '%40'   '#' → '%23'   '!' → '%21'
# Example: 'planner@2026' → 'planner%402026'
MYSQL_PASSWORD=planner%402026

# ──────────────────────────────────────────
# Application
# ──────────────────────────────────────────
# Generate a secure key: openssl rand -hex 64
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
ENVIRONMENT=production

# ──────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────
# Set this to your server's domain or IP
# The /api suffix ensures the frontend routes API calls through Nginx
# Examples:
#   http://192.168.30.90/api
#   https://demandplanner.company.com/api
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP/api

# ──────────────────────────────────────────
# SAP B1 Integration (Optional)
# ──────────────────────────────────────────
# SAP_URL=https://sap-server:50000/b1s/v1
# SAP_COMPANY_DB=YOUR_COMPANY_DB
# SAP_USERNAME=your_sap_user
# SAP_PASSWORD=your_encrypted_password
