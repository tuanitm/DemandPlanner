# ============================================
# DemandPlanner Production Environment
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# --- PostgreSQL ---
POSTGRES_DB=demandplanner
POSTGRES_USER=dpuser
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# --- Application ---
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
ENVIRONMENT=production

# --- Frontend ---
# Set this to your server's domain or IP address
# Example: http://192.168.1.100/api  or  https://demandplanner.company.com/api
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP/api
